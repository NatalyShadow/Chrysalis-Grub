# Chrysalis — environment (copy to .env, never commit .env)
# Bot token from the Discord Developer Portal. Requires MANAGE_GUILD + MANAGE_ROLES.
DISCORD_TOKEN=replace-me

# Source guild (fixed): the server that `sync` exports into config/clone/.
# Never changes; the clone target id is passed per command (TARGET_ID / --guild).
GUILD_ID=replace-me